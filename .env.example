# Copy to .env.local (local) or set these in your host's dashboard (Vercel etc.).
# NEVER commit real values.

# --- Server ---
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Optional: extra origins allowed to call the API from a browser (comma separated)
ALLOWED_ORIGINS=

# --- Database (required in production; without it data lives in memory and is lost) ---
MONGODB_URI=

# --- Sessions ---
# Days a login stays valid (default 30)
SESSION_MAX_AGE_DAYS=30

# --- Admin access ---
# The owner email(s) that get the admin role (comma separated). ADMIN_NOTIFICATION_EMAIL is also an admin.
ADMIN_EMAILS=
ADMIN_NOTIFICATION_EMAIL=
COLLABORATION_EMAIL=

# --- PayPal (REQUIRED for checkout: there are no built-in default keys any more) ---
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_HOSTED_PAYMENT_URL=

# --- Cloudflare R2 (REQUIRED for uploads / protected downloads) ---
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=owl
CLOUDFLARE_R2_PUBLIC_URL=

# --- Cloudinary (images) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Email (Resend, or SMTP fallback) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_DOMAIN_VERIFIED=
RESEND_WEBHOOK_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
